   "source": [
    "import torch\n",
    "import torch.nn as nn \n",
    "import torch.optim as optim\n",
    "\n",
    "# Tạo 1 lớp linear đơn giản\n",
    "model = nn.Linear(4,2)\n",
    "\n",
    "# Tạo optimizer Adam để cập nhật trọng số model \n",
    "# lr là learning rate\n",
    "optimizer = optim.Adam(model.parameters(),lr=0.001)\n",
    "\n",
    "# In ra optimizer\n",
    "print(optimizer)"
   ]
